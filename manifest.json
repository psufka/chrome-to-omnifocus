{
  "manifest_version": 3,
  "name": "Chrome to OmniFocus by Paul Sufka",
  "version": "1.2.2",
  "description": "Send the current tab or selected text to OmniFocus Quick Entry, ready to review and save.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "chrome-to-omnifocus.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Send to OmniFocus Quick Entry"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
